{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentknowledgevault.dev/schemas/v0.1/context-capsule.schema.json",
  "title": "Context Capsule v0.1",
  "description": "A bounded, evidence-preserving, task-scoped retrieval artifact for an Agent.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "status",
    "context",
    "critical_facts",
    "constraints",
    "pitfalls",
    "unresolved",
    "knowledge_refs",
    "evidence",
    "retrieval",
    "budget"
  ],
  "properties": {
    "schema_version": {"const": "0.1"},
    "status": {"enum": ["complete", "degraded", "failed"]},
    "context": {"type": "string", "maxLength": 1000000},
    "critical_facts": {"$ref": "#/$defs/claims"},
    "constraints": {"$ref": "#/$defs/claims"},
    "pitfalls": {"$ref": "#/$defs/claims"},
    "unresolved": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/unresolved_item"}
    },
    "knowledge_refs": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/knowledge_ref"}
    },
    "evidence": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/evidence_item"}
    },
    "retrieval": {"$ref": "#/$defs/retrieval"},
    "budget": {"$ref": "#/$defs/budget_report"}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "failed"}}, "required": ["status"]},
      "then": {
        "properties": {
          "context": {"maxLength": 0},
          "critical_facts": {"maxItems": 0},
          "constraints": {"maxItems": 0},
          "pitfalls": {"maxItems": 0},
          "evidence": {"maxItems": 0},
          "unresolved": {"minItems": 1},
          "budget": {
            "properties": {"outcome": {"const": "failed"}},
            "required": ["outcome"]
          }
        }
      }
    }
  ],
  "$defs": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"},
    "knowledge_uri": {
      "type": "string",
      "pattern": "^vault://[A-Za-z0-9][A-Za-z0-9._-]{0,127}/[A-Za-z0-9][A-Za-z0-9._~!$&'()*+,;=:@%-]{0,511}$"
    },
    "reference_ids": {
      "type": "array",
      "maxItems": 1000,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "confidence", "knowledge_refs", "evidence_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "statement": {"type": "string", "minLength": 1, "maxLength": 4096},
        "confidence": {"enum": ["high", "medium", "low"]},
        "knowledge_refs": {"$ref": "#/$defs/reference_ids"},
        "evidence_refs": {"$ref": "#/$defs/reference_ids"}
      },
      "anyOf": [
        {"properties": {"knowledge_refs": {"minItems": 1}}},
        {"properties": {"evidence_refs": {"minItems": 1}}}
      ]
    },
    "claims": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/claim"}
    },
    "unresolved_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "question", "knowledge_refs", "evidence_refs"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "kind": {"enum": ["unresolved", "insufficient_evidence", "conflicting_evidence"]},
        "question": {"type": "string", "minLength": 1, "maxLength": 4096},
        "knowledge_refs": {"$ref": "#/$defs/reference_ids"},
        "evidence_refs": {"$ref": "#/$defs/reference_ids"}
      },
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "conflicting_evidence"}}, "required": ["kind"]},
          "then": {"properties": {"evidence_refs": {"minItems": 2}}}
        }
      ]
    },
    "knowledge_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uri"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "uri": {"$ref": "#/$defs/knowledge_uri"},
        "revision": {"type": "string", "minLength": 1, "maxLength": 256}
      }
    },
    "evidence_item": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "knowledge_ref", "excerpt", "provenance"],
      "properties": {
        "id": {"$ref": "#/$defs/id"},
        "knowledge_ref": {"$ref": "#/$defs/id"},
        "excerpt": {"type": "string", "minLength": 1, "maxLength": 512},
        "provenance": {
          "type": "object",
          "additionalProperties": false,
          "required": ["source_type", "handle"],
          "properties": {
            "source_type": {"enum": ["okf", "repository", "web", "operator", "other"]},
            "handle": {"type": "string", "minLength": 1, "maxLength": 2048}
          }
        }
      }
    },
    "retrieval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "level", "path", "terminal_reason"],
      "properties": {
        "mode": {"enum": ["fast", "auto", "thorough"]},
        "level": {"type": "integer", "minimum": 0, "maximum": 2},
        "path": {
          "type": "array",
          "minItems": 1,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"type": "integer", "minimum": 0, "maximum": 2}
        },
        "terminal_reason": {
          "enum": ["sufficient", "budget_limited", "level_limit", "insufficient_evidence", "conflict", "error"]
        }
      },
      "oneOf": [
        {
          "properties": {
            "mode": {"const": "fast"},
            "level": {"const": 0},
            "path": {"const": [0]}
          }
        },
        {
          "properties": {"mode": {"const": "auto"}},
          "oneOf": [
            {"properties": {"level": {"const": 0}, "path": {"const": [0]}}},
            {"properties": {"level": {"const": 1}, "path": {"const": [0, 1]}}},
            {"properties": {"level": {"const": 2}, "path": {"const": [0, 1, 2]}}}
          ]
        },
        {
          "properties": {"mode": {"const": "thorough"}},
          "oneOf": [
            {"properties": {"level": {"const": 0}, "path": {"const": [0]}}},
            {"properties": {"level": {"const": 1}, "path": {"const": [1]}}},
            {"properties": {"level": {"const": 2}, "path": {"const": [2]}}},
            {"properties": {"level": {"const": 1}, "path": {"const": [0, 1]}}},
            {"properties": {"level": {"const": 2}, "path": {"const": [0, 2]}}},
            {"properties": {"level": {"const": 2}, "path": {"const": [1, 2]}}},
            {"properties": {"level": {"const": 2}, "path": {"const": [0, 1, 2]}}}
          ]
        }
      ]
    },
    "budget_report": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requested_tokens",
        "method",
        "precision",
        "used",
        "hard_limit",
        "limit_unit",
        "serialized_bytes",
        "evidence_items",
        "outcome"
      ],
      "properties": {
        "requested_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "method": {"enum": ["exact_tokenizer", "utf8_bytes"]},
        "precision": {"enum": ["exact", "conservative"]},
        "tokenizer_id": {"type": "string", "minLength": 1, "maxLength": 256},
        "used": {"type": "integer", "minimum": 0},
        "hard_limit": {"type": "integer", "minimum": 1},
        "limit_unit": {"enum": ["tokens", "utf8_bytes"]},
        "serialized_bytes": {"type": "integer", "minimum": 0},
        "evidence_items": {"type": "integer", "minimum": 0, "maximum": 1000},
        "outcome": {"enum": ["within_budget", "degraded", "failed"]}
      },
      "allOf": [
        {
          "if": {"properties": {"method": {"const": "exact_tokenizer"}}, "required": ["method"]},
          "then": {
            "required": ["tokenizer_id"],
            "properties": {
              "precision": {"const": "exact"},
              "limit_unit": {"const": "tokens"}
            }
          }
        },
        {
          "if": {"properties": {"method": {"const": "utf8_bytes"}}, "required": ["method"]},
          "then": {
            "properties": {
              "precision": {"const": "conservative"},
              "limit_unit": {"const": "utf8_bytes"}
            },
            "not": {"required": ["tokenizer_id"]}
          }
        }
      ]
    }
  }
}
